+// notifyLvglFBStream 只在被 LVGL 外壳拉起时往 stdout 发事件：
+//
+//	FBSTART  外壳暂停整屏输出（lv_timer_enable(false)），屏幕交给本进程
+//	FBEND    外壳恢复输出并重绘整屏
+//
+// 非 lvgl 模式下 stdout 是终端，不能污染，所以直接不打印。
+func notifyLvglFBStream(active bool) {
+	if !conf.IsLvgl {
+		return
+	}
+	if active {
+		app.SendLocal("FBSTART")
+	} else {
+		app.SendLocal("FBEND")
+	}
+}
